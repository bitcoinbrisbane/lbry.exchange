{
  "name": "lbry-bridge-functions",
  "version": "0.1.0",
  "private": true,
  "description": "DigitalOcean Functions backend for the LBRY bridge: wrap (LBC -> wLBC) and unwrap (wLBC -> LBC)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy": "npm run build && doctl serverless deploy .",
    "dev": "node scripts/build.mjs && node scripts/dev.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28",
    "typescript": "^5.9.0",
    "vite": "^8",
    "vitest": "^5"
  }
}
