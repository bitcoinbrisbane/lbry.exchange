# Base URL of the API server
VITE_API_URL=http://localhost:3000

# Maximum LBC allowed per buy order (defaults to 1000 if unset)
VITE_MAX_LBC=1000

# Address of the wrapped LBC (wLBC) ERC-20 on Ethereum
VITE_WLBC_ADDRESS=0x0000000000000000000000000000000000000000

# Read-only Ethereum RPC endpoint (used to read total supply without a wallet)
VITE_ETH_RPC_URL=https://eth.llamarpc.com
