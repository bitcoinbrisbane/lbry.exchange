# Base URL of the bridge functions web package (see src/functions/README.md)
VITE_BRIDGE_API_URL=https://faas-xxx.doserverless.co/api/v1/web/<namespace>/bridge

# Contract addresses
VITE_WLBC_ADDRESS=0x0000000000000000000000000000000000000000
